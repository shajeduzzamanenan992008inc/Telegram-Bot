# ==============================================================================
# Diff Drivers & GitHub Linguist / Archive Hygiene
# ==============================================================================
# Better function-context diffs for Python
*.py diff=python

# Treat lockfiles and generated assets as non-diffable noise in PRs (still tracked)
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
poetry.lock linguist-generated=true
Pipfile.lock linguist-generated=true
uv.lock linguist-generated=true

# Exclude local/dev-only files from `git archive` exports
.gitattributes export-ignore
.gitignore export-ignore
.dockerignore export-ignore
.env* export-ignore
!.env.example export-ignore
tests/ export-ignore
*.test.py export-ignore
*_test.py export-ignore