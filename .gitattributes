# ==============================================================================
# Line Endings & Normalization
# ==============================================================================
# Normalize all text files to LF in the repository to prevent CRLF/LF churn
# across Linux CI/CD, Linux production runtimes, macOS, and Windows contributors.
* text=auto eol=lf

# Explicitly enforce LF for source, config, script, and markup files
*.py text eol=lf
*.pyi text eol=lf
*.pyx text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.jinja text eol=lf
*.jinja2 text eol=lf
*.j2 text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.env text eol=lf
*.example text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.dockerignore text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf

