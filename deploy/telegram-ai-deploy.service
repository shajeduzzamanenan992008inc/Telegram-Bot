[Unit]
Description=Restricted Enan Ultra release deployment broker
After=telegram-ai-deploy.socket
Requires=telegram-ai-deploy.socket

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/telegram-ai-deploy --serve
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/opt/enan-ultra /var/lib/telegram-ai-deploy
