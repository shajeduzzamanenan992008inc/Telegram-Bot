# EXAMPLE ONLY. Select only languages/code scanning features supported by this repo
# and its GitHub plan. Pin all actions to full SHAs verified from official sources.
name: CodeQL Security Analysis (example)
on:
  push:
    branches: ["<DEFAULT_BRANCH>"]
  pull_request:
    branches: ["<DEFAULT_BRANCH>"]
  schedule:
    - cron: "17 4 * * 1"
permissions:
  contents: read
jobs:
  analyze:
    name: Analyze (${{ matrix.language }})
    runs-on: ubuntu-latest
    permissions:
      actions: read
      contents: read
      security-events: write
    strategy:
      fail-fast: false
      matrix:
        # Keep only languages that exist in the repository.
        include:
          - language: python
            build-mode: none
          - language: javascript-typescript
            build-mode: none
          # Add compiled languages with the correct build-mode/manual build steps.
    steps:
      - uses: actions/checkout@<VERIFIED_40_CHARACTER_COMMIT_SHA>
        with:
          persist-credentials: false
      - uses: github/codeql-action/init@<VERIFIED_40_CHARACTER_COMMIT_SHA>
        with:
          languages: ${{ matrix.language }}
          build-mode: ${{ matrix.build-mode }}
          queries: security-extended
      - uses: github/codeql-action/analyze@<VERIFIED_40_CHARACTER_COMMIT_SHA>
        with:
          category: "/language:${{ matrix.language }}"
