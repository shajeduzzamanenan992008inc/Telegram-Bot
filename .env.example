# Enan Ultra Telegram AI Assistant - configuration template.
#
# Copy this file with `python scripts/init_env.py` (it generates APP_DATA_KEY and
# DASHBOARD_AUTH_TOKEN for you) or copy it to `.env` by hand. Never put real secrets in
# `.env.example` and never commit `.env`.
#
# Format rules (the same file is read by python-dotenv and by systemd EnvironmentFile):
#   * one KEY=value per line, no quotes, no spaces around "="
#   * comments live on their own line; do not append "# comment" after a value
#   * leave optional values blank to use the built-in default shown in the comment

# ---------------------------------------------------------------------------
# Brand and access
# ---------------------------------------------------------------------------
BOT_NAME=Enan Ultra
BOT_DISPLAY_NAME=Enan Ultra AI
AI_PERSONA_PROFILE=GPT-6 Astra
# Required. Token from @BotFather, e.g. 123456789:AA... (never share it).
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# Required. Numeric ID of the private admin/support chat (use your own user ID for a private chat).
ADMIN_CHAT_ID=
# Required. Comma-separated numeric Telegram user IDs of administrators.
ADMIN_USER_IDS=
# Optional. Single user ID allowed to apply /update ZIPs. Defaults to the lowest ADMIN_USER_IDS value.
ADMIN_ID=
# public: any user may chat. allowlist: only ALLOWED_USER_IDS (plus admins).
# The runtime Private/Public mode stored in the database is enforced on top of this: a fresh
# installation starts in Private Mode (administrators only) until an admin sends /setmode public.
ACCESS_MODE=public
# Comma-separated numeric user IDs. Required when ACCESS_MODE=allowlist.
ALLOWED_USER_IDS=

# ---------------------------------------------------------------------------
# AI providers (configure at least one; plural variables hold up to 10 rotating keys)
# ---------------------------------------------------------------------------
# Provider routing order for cloud fallback. Each supported cloud provider at most once:
# openrouter, groq, gemini, cloudflare, huggingface
AI_PROVIDER_ORDER=openrouter,groq,gemini,cloudflare,huggingface
# "auto" lets the router choose the first configured provider/model.
DEFAULT_AI_MODEL=auto
# Comma-separated provider::model-id (or OpenRouter model IDs) tried after the default model.
FALLBACK_MODELS=

# OpenRouter (also used for web search, image generation, speech and file operations)
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional model override; DEFAULT_AI_MODEL is used when blank.
OPENROUTER_MODEL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Required when a Gemini key is set, e.g. gemini-2.5-flash
GEMINI_MODEL=

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Required when a Groq key is set.
GROQ_MODEL=

# Cloudflare Workers AI (OpenAI-compatible). Key precedence: CLOUDFLARE_API_TOKENS,
# CLOUDFLARE_API_KEYS, CLOUDFLARE_API_KEY. Needs the 32-character account ID and a model.
CLOUDFLARE_API_KEY=
CLOUDFLARE_API_KEYS=
CLOUDFLARE_API_TOKENS=
CLOUDFLARE_ACCOUNT_ID=
# Optional; derived from CLOUDFLARE_ACCOUNT_ID when blank.
CLOUDFLARE_BASE_URL=
CLOUDFLARE_MODEL=

# Hugging Face Inference Providers (OpenAI-compatible)
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_KEYS=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# Required when a Hugging Face key is set.
HUGGINGFACE_MODEL=

# Local Ollama (preferred first when DEFAULT_AI_MODEL=auto; required for local-only mode)
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Reserved credentials. The settings loader parses and validates these, but this release has no
# adapter that routes requests to them (see docs/FEATURES.md for the supported provider list).
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
TOGETHER_API_KEY=
TOGETHER_API_KEYS=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_API_KEYS=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=

# ---------------------------------------------------------------------------
# Provider reliability, routing and cost control
# ---------------------------------------------------------------------------
# Seconds per provider request (1-300).
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES_PER_KEY=1
AI_MAX_TOTAL_ATTEMPTS=5
AI_CIRCUIT_BREAKER_THRESHOLD=3
# Seconds a failing provider stays paused (1-86400).
AI_CIRCUIT_BREAKER_COOLDOWN=60
# true: only models listed in AI_FREE_MODEL_ALLOWLIST (exact provider::model-id entries).
AI_FREE_ONLY=false
AI_FREE_MODEL_ALLOWLIST=
# Paid fallback stays off unless enabled; then AI_MAX_ESTIMATED_COST_USD must be positive.
AI_ALLOW_PAID_FALLBACK=false
AI_MAX_ESTIMATED_COST_USD=0
# Explicit capability lists (provider::model-id, comma separated).
AI_TOOL_CAPABLE_MODELS=
AI_IMAGE_CAPABLE_MODELS=
AI_STREAMING_MODELS=
PROVIDER_REQUEST_RESERVE_USD=0.10

# ---------------------------------------------------------------------------
# Agents and media models
# ---------------------------------------------------------------------------
AGENTS_ENABLED_BY_DEFAULT=true
AGENT_MAX_STEPS=4
AGENT_MAX_WORKERS=2
AGENT_MAX_COST_USD=0.50
# Models must support the capability on their provider. Leave blank to disable that feature.
STT_MODEL=
TTS_MODEL=
TTS_VOICE=alloy
VISION_MODEL=google/gemini-2.5-flash:free
IMAGE_MODEL=
# Comma-separated words that make the bot answer in group chats.
TRIGGER_WORDS=

# ---------------------------------------------------------------------------
# Storage and limits
# ---------------------------------------------------------------------------
# The Ubuntu installer rewrites this default to /var/lib/telegram-ai/telegram_ai.sqlite3.
DATABASE_PATH=data/telegram_ai.sqlite3
HISTORY_MESSAGES=12
MAX_INPUT_CHARS=12000
MAX_OUTPUT_CHARS=24000
# Above 20 MB requires LOCAL_BOT_API_BASE_URL.
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_BYTES=3145728
MAX_IMAGE_PIXELS=40000000
MAX_ARCHIVE_EXPANDED_BYTES=52428800
MAX_ARCHIVE_FILES=100
MAX_ARCHIVE_DEPTH=2
MAX_DOCUMENT_PAGES=100
MAX_VIDEO_SECONDS=120
MAX_VIDEO_FRAMES=4
MAX_AUDIO_SECONDS=600
REQUEST_COOLDOWN_SECONDS=1.5
USER_DAILY_REQUEST_LIMIT=40
USER_MONTHLY_REQUEST_LIMIT=1200
USER_MONTHLY_COST_LIMIT_USD=50
MAX_DAILY_COST_USD=5
IMAGE_COST_RESERVE_USD=0.10
TTS_COST_RESERVE_USD=0.03
WEB_SEARCH_COST_RESERVE_USD=0.01
DOCUMENT_RETENTION_HOURS=24
MAX_PENDING_REMINDERS=20
MAX_DOCUMENT_CHUNKS=200

# ---------------------------------------------------------------------------
# Telegram ZIP updates (/update). Deployment through the root broker is off by default.
# ---------------------------------------------------------------------------
UPDATE_MAX_FILES=1000
UPDATE_MAX_DEPTH=8
UPDATE_MAX_PATH_LENGTH=240
UPDATE_MAX_COMPRESSION_RATIO=100
UPDATE_EXTRACT_TIMEOUT_SECONDS=60
UPDATE_TEST_TIMEOUT_SECONDS=180
UPDATE_UPLOAD_WINDOW_SECONDS=300
UPDATE_DEPLOYMENT_ENABLED=false
UPDATE_DEPLOYMENT_SOCKET_PATH=/run/telegram-ai-deploy.sock

# ---------------------------------------------------------------------------
# Memory, knowledge base and features
# ---------------------------------------------------------------------------
MEMORY_ENABLED_BY_DEFAULT=false
PERSONAL_KB_ENABLED=true
# Required secret (at least 32 characters) for the encrypted KB and encrypted backups.
# Keep it stable: changing it makes existing encrypted data unreadable.
APP_DATA_KEY=replace-with-generated-secret
PERSONAL_KB_MAX_DOCUMENTS=50
PERSONAL_KB_MAX_BYTES=104857600
REMOTE_FILE_FALLBACK=true
WEB_SEARCH_ENABLED=true
IMAGE_GENERATION_ENABLED=true
VOICE_INPUT_ENABLED=true
# off, on_voice_input or always
VOICE_OUTPUT_MODE=on_voice_input
STICKER_ENABLED=true
# Comma-separated Telegram sticker file IDs the model may send.
STICKER_FILE_IDS=
# balanced, minimal or expressive
MEDIA_STYLE=balanced
ADMIN_ALERTS=true
# The Ubuntu installer enables this for new deployments (needs clamav-daemon).
MALWARE_SCAN_ENABLED=false
CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.ctl
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Transport, dashboard and integrations
# ---------------------------------------------------------------------------
# Set both together when running a local Bot API server (needed for uploads above 20 MB).
LOCAL_BOT_API_BASE_URL=
LOCAL_BOT_API_FILE_URL=
DASHBOARD_ENABLED=true
# Must stay 127.0.0.1; reach the dashboard through an SSH tunnel.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Required secret (at least 32 characters) when the dashboard is enabled.
DASHBOARD_AUTH_TOKEN=replace-with-generated-secret
# Telegram Mini App: public HTTPS origin only (no path), e.g. https://bot.example.com. Blank disables it.
MINI_APP_URL=
MINI_APP_HOST=127.0.0.1
MINI_APP_PORT=8788
# Home Assistant (both or neither). Entities/services must be exact domain.name IDs.
HA_BASE_URL=
HA_TOKEN=
HA_ALLOWED_ENTITIES=
HA_ALLOWED_SERVICES=

# ---------------------------------------------------------------------------
# Code sandbox (requires rootless Docker and the image built from deploy/code-sandbox.Dockerfile)
# ---------------------------------------------------------------------------
CODE_SANDBOX_ENABLED=false
CODE_SANDBOX_IMAGE=enan-ultra-python-sandbox:py3.15.0-pytest9.1.1
CODE_SANDBOX_TIMEOUT_SECONDS=30
CODE_SANDBOX_MEMORY_MB=512
CODE_SANDBOX_CPU_COUNT=1.0
CODE_SANDBOX_MAX_FILES=100
CODE_SANDBOX_MAX_EXPANDED_BYTES=52428800
