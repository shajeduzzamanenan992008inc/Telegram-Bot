MAX_ARCHIVE_FILES=100
MAX_ARCHIVE_DEPTH=2
MAX_DOCUMENT_PAGES=100
MAX_VIDEO_SECONDS=120
MAX_VIDEO_FRAMES=4
MAX_AUDIO_SECONDS=600
REQUEST_COOLDOWN_SECONDS=1.5
USER_DAILY_REQUEST_LIMIT=40
USER_MONTHLY_REQUEST_LIMIT=1200
