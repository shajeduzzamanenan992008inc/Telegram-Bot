REMOTE_FILE_FALLBACK=true
WEB_SEARCH_ENABLED=true
IMAGE_GENERATION_ENABLED=true
VOICE_INPUT_ENABLED=true
VOICE_OUTPUT_MODE=on_voice_input
STICKER_ENABLED=true
STICKER_FILE_IDS=
